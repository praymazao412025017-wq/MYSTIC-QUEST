comment4.text=\r\npublic\ void\ moveIfPossible(int\ dx,\ int\ dy)\r\n{\r\n\ \ \ \ //\ Periksa\ gerakan\ horizontal\r\n\ \ \ \ if\ (dx\ \!\=\ 0\ &&\ canMoveTo(getX()\ +\ dx,\ getY()))\r\n\ \ \ \ {\r\n\ \ \ \ \ \ \ \ setLocation(getX()\ +\ dx,\ getY());\r\n\ \ \ \ }\r\n\r\n\ \ \ \ //\ Periksa\ gerakan\ vertikal\r\n\ \ \ \ if\ (dy\ \!\=\ 0\ &&\ canMoveTo(getX(),\ getY()\ +\ dy))\r\n\ \ \ \ {\r\n\ \ \ \ \ \ \ \ setLocation(getX(),\ getY()\ +\ dy);\r\n\ \ \ \ }\r\n}\r\n
